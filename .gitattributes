# Shell and Python scripts are run by their shebang on Linux as well as by bash
# on Windows, and a CRLF line ending makes the interpreter name "bash\r".
*.sh    text eol=lf
*.py    text eol=lf

# The fixtures are compared by FileCheck against emitted text, where a CRLF
# would be a spurious mismatch. The hand-written `.uasm` in Inputs/ is assembled
# by the SDK's own scanner, which treats the trailing byte as data.
*.ll    text eol=lf
*.uasm  text eol=lf

# Generated tables are diffed by the generator's --check, which compares bytes.
*.def   text eol=lf
*.json  text eol=lf
